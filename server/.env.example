# Copy this file to .env and fill in your values
PORT=5000
NODE_ENV=development
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# ── AI providers ─────────────────────────────────────────────
# Switch active provider from Admin → Settings → AI Configuration
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# ── Payment gateways ─────────────────────────────────────────
# Switch active gateway from Admin → Settings → Payment Gateway
# Add keys for the gateways you want to use; only configured gateways can be activated
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Frontend URL — used for redirect-based checkout callbacks (Stripe, Flutterwave)
FRONTEND_URL=http://localhost:5173

# ── Email providers ──────────────────────────────────────────
# Switch active provider from Admin → Settings → Integrations
RESEND_API_KEY=
SENDGRID_API_KEY=

# ── CORS & security ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173

# ── Payments (Paystack public key goes in client .env) ───────
PAYSTACK_PUBLIC_KEY=

# ── Error tracking ───────────────────────────────────────────
# Sign up at sentry.io → create a Node.js project → copy DSN
# Leave blank to disable Sentry
SENTRY_DSN=
